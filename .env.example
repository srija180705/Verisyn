# Copy this file to .env and fill in real values locally. Never commit .env.

# Backend / Database
DATABASE_URL=postgresql+psycopg://fraud_app:fraud_app@localhost:5432/fraud_intelligence

# Auth (not implemented in this prototype - internal single-operator tool)
JWT_SECRET=

# AI investigation explanation - advisory only, never affects fraud
# scoring. Optional: leave AI_PROVIDER blank and the "Generate AI
# Explanation" button degrades gracefully with no error.
#
# AI_PROVIDER selects exactly one provider: "groq" or "bedrock".
AI_PROVIDER=groq

# Groq (https://console.groq.com - free API key, no billing setup)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Bedrock. Region/model are configured here, but AWS CREDENTIALS are NOT -
# boto3 resolves those itself via standard AWS environment variables
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN exported in
# your shell) or ~/.aws/credentials, never from this file.
AWS_REGION=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
